# Mobilint customer-capacity-repro — 런타임(추론) 전용 이미지
#
# 벤더 README 의 "4. 실행 환경 설치" 절차를 그대로 옮긴 것이다.
# 호스트에 아무것도 설치하지 않는다 — 드라이버(1.13)는 호스트 것을 그대로 쓰고
# 유저스페이스 런타임만 컨테이너 안에 둔다.
#
# 컴파일은 이 이미지로 하지 않는다(CUDA 12.8 GPU 필요, 별도 이미지/서버).
#
#   docker build -f setup/vlm_repro/Dockerfile.runtime -t mblt_vlm_repro:rt \
#       download/vendor/customer-capacity-repro      # ← 빌드 컨텍스트 = 재현 패키지
#   bash setup/vlm_repro/run_runtime.sh --sizes 224x224 --repetitions 2 --output results/smoke
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.10 python3.10-venv python3-pip \
        libgomp1 libgl1 libglib2.0-0 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /repro
# requirements 와 wheel 만 먼저 복사해 레이어 캐시를 살린다.
COPY requirements-runtime.txt /repro/
COPY wheels/qbruntime-1.4.0+repack1-cp310-cp310-linux_x86_64.whl \
     wheels/mblt_model_zoo-2.3.0+tta1-py3-none-any.whl /repro/wheels/

RUN python3.10 -m pip install --upgrade pip \
 && python3.10 -m pip install torch==2.9.0+cu128 torchvision==0.24.0+cu128 \
        --index-url https://download.pytorch.org/whl/cu128 \
 && python3.10 -m pip install -r requirements-runtime.txt \
 && python3.10 -m pip install --no-deps \
        /repro/wheels/qbruntime-1.4.0+repack1-cp310-cp310-linux_x86_64.whl \
        /repro/wheels/mblt_model_zoo-2.3.0+tta1-py3-none-any.whl \
 && python3.10 -c 'import qbruntime; print("qbruntime", qbruntime.__version__)'

ENV PYTHONPATH=/repro/src
CMD ["/bin/bash"]
